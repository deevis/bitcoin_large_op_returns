aserbeams" id="laserbeams"></div>\n<div class="smoke" id="smoke"></div>\n<div class="scanlines" id="scanlines"></div>\n<div class="vignette" id="vignette"></div>\n<div class="strobe" id="strobe"></div>\n<div class="lightning" id="lightning"></div>\n<div class="particles" id="particles"></div>\n<div class="rarity-trigger" id="rarityTrigger" title="Rarity"></div>\n<div class="rarity-backdrop" id="rarityBackdrop"></div>\n<div class="rarity-card" id="rarityCard">\n<div class="close-x" id="rarityClose">√ó</div>\n<h1>HYPNO-FROCAT</h1>\n<div class="token-id" id="rcTokenId">‚Äî</div>\n<div class="rank-row" id="rcRank"><div class="loading">Computing rarity</div></div>\n<div class="section-title">Traits</div>\n<ul class="traits-list" id="rcTraits"></ul>\n<div class="debug-hash">\n<div class="debug-hash-label">seed (sha256)</div>\n<div class="debug-hash-value" id="rcHash">‚Äî</div>\n</div>\n</div>\n</div>`;\n\n  acme.ready.then(function(){\n\nconst COLLECTION_NAME = \'HYPNOFROCAT\';\nconst COLLECTION_SIZE = 333;\n\nconst $ = function(id){return document.getElementById(id);};\nconst stage = $(\'stage\'), frog = $(\'frog\');\nconst backdropClip = $(\'backdropClip\'), spiral = $(\'spiral\');\nconst scanlines = $(\'scanlines\'), vignette = $(\'vignette\');\nconst strobe = $(\'strobe\'), lightning = $(\'lightning\'), particles = $(\'particles\');\nconst smoke = $(\'smoke\'), laserbeams = $(\'laserbeams\');\nconst plasma = $(\'plasma\'), checker = $(\'checker\'), rays = $(\'rays\');\nconst waves = $(\'waves\'), dots = $(\'dots\'), aurora = $(\'aurora\');\nconst stars = $(\'stars\'), disco = $(\'disco\');\nconst confetti = $(\'confetti\'), neongrid = $(\'neongrid\'), cmyk = $(\'cmyk\');\nconst rstripes = $(\'rstripes\'), kaleido = $(\'kaleido\'), ncircles = $(\'ncircles\');\nconst prism = $(\'prism\'), bubbles = $(\'bubbles\');\nconst bodyPath = document.querySelector(\'.body-path\');\n\nfunction sfc32(h) {\n  let a = parseInt(h.slice(2, 10), 16) | 0;\n  let b = parseInt(h.slice(10, 18), 16) | 0;\n  let c = parseInt(h.slice(18, 26), 16) | 0;\n  let d = parseInt(h.slice(26, 34), 16) | 0;\n  return function() {\n    a |= 0; b |= 0; c |= 0; d |= 0;\n    const t = (a + b | 0) + d | 0;\n    d = d + 1 | 0;\n    a = b ^ (b >>> 9);\n    b = c + (c << 3) | 0;\n    c = (c << 21) | (c >>> 11);\n    c = c + t | 0;\n    return (t >>> 0) / 4294967296;\n  };\n}\n\nasync function deriveSeed(name) {\n  const buf = new TextEncoder().encode(name);\n  const hash = await crypto.subtle.digest(\'SHA-256\', buf);\n  return \'0x\' + Array.from(new Uint8Array(hash), b => b.toString(16).padStart(2, \'0\')).join(\'\');\n}\n\nfunction weightedPick(rng, items) {\n\n  const total = items.reduce((a, b) => a + b.weight, 0);\n  let r = rng() * total;\n  for (const it of items) {\n    r -= it.weight;\n    if (r <= 0) return it;\n  }\n  return items[items.length - 1];\n}\n\nconst EYE_TYPES = [\n  { name: \'HYPNO\', weight: 8 },\n  { name: \'BUZZED\', weight: 6 },\n  { name: \'EVIL\', weight: 4 },\n  { name: \'STONED\', weight: 4 },\n  { name: \'CROSS-EYED\', weight: 6 },\n  { name: \'WIDE\', weight: 8 },\n  { name: \'X-DEAD\', weight: 2 },\n  { name: \'LASER\', weight: 2 },\n  { name: \'KAWAII\', weight: 5 },\n  { name: \'ALIEN\', weight: 3 },\n  { name: \'FIRE\', weight: 3 },\n  { name: \'VOID\', weight: 1 },\n  { name: \'TIGHT-SPIRAL\', weight: 5 },\n  { name: \'WINK\', weight: 5 },\n  { name: \'ROLLING\', weight: 4 },\n];\nconst EYE_MOVES = [\n  { name: \'STILL\', weight: 4 },\n  { name: \'SIDE-TO-SIDE\', weight: 6 },\n  { name: \'OPPOSITE\', weight: 5 },\n  { name: \'UP-DOWN\', weight: 5 },\n  { name: \'CONVERGE\', weight: 4 },\n  { name: \'DART\', weight: 3 },\n  { name: \'WANDER\', weight: 5 },\n  { name: \'CIRCLE-SAME\', weight: 4 },\n  { name: \'CIRCLE-MIRROR\', weight: 3 },\n];\nconst BODY_STYLES = [\n  { name: \'CLASSIC\', weight: 12 },\n  { name: \'OUTLINE\', weight: 6 },\n  { name: \'OUTLINE-RAINBOW\', weight: 4 },\n  { name: \'NEON-WIRE\', weight: 5 },\n  { name: \'PINK-WIRE\', weight: 5 },\n  { name: \'MARCH\', weight: 4 },\n  { name: \'MARCH-RAINBOW\', weight: 3 },\n  { name: \'PULSE-STROKE\', weight: 5 },\n  { name: \'RAINBOW-FILL\', weight: 8 },\n  { name: \'SUNSET-FILL\', weight: 6 },\n  { name: \'VAPORWAVE\', weight: 5 },\n  { name: \'ACID\', weight: 4 },\n  { name: \'FIRE-BODY\', weight: 4 },\n  { name: \'ICE-BODY\', weight: 4 },\n  { name: \'GOLD\', weight: 2 },\n  { name: \'PORTAL\', weight: 3 },\n  { name: \'BLACK-HOLE\', weight: 2 },\n  { name: \'POLKA-DOTS\', weight: 5 },\n  { name: \'CHECKERS\', weight: 5 },\n  { name: \'STRIPES\', weight: 5 },\n  { name: \'GRID\', weight: 4 },\n  { name: \'ZEBRA\', weight: 6 },\n  { name: \'LEOPARD\', weight: 5 },\n  { name: \'HONEYCOMB\', weight: 4 },\n  { name: \'SHIMMER\', weight: 4 },\n  { name: \'PULSE-GLOW\', weight: 3 },\n  { name: \'STROBE-FILL\', weight: 2 },\n  { name: \'LIQUID\', weight: 3 },\n  { name: \'SCROLL-DOTS\', weight: 4 },\n  { name: \'CHROMA-GHOST\', weight: 2 },\n  { name: \'SCAN-LINE\', weight: 3 },\n];\nconst BODY_MOTIONS = [\n  { name: \'STILL\', weight: 1 },\n  { name: \'ROT-SLOW\', weight: 6 },\n  { name: \'ROT-MED\', weight: 6 },\n  { name: \'ROT-FAST\', weight: 3 },\n  { name: \'ROT-REVERSE\', weight: 4 },\n  { name: \'ROCK\', weight: 6 },\n  { name: \'TILT\', weight: 5 },\n  { name: \'BOB\', weight: 5 },\n  { name: \'ORBIT\', weight: 3 },\n];\nconst AMBIENT_FX = [\n  { name: \'WOBBLE\', weight: 5 },\n  { name: \'SHAKE\', weight: 5 },\n  { name: \'MEGA-SHAKE\', weight: 2 },\n  { name: \'BOUNCE\', weight: 5 },\n  { name: \'BREATHE\', weight: 5 },\n  { name: \'SWAY\', weight: 5 },\n  { name: \'DEFORM\', weight: 3 },\n  { name: \'GLITCH\', weight: 2 },\n  { name: \'HUE\', weight: 5 },\n  { name: \'INVERT\', weight: 3 },\n  { name: \'GLOW\', weight: 5 },\n  { name: \'CHROMA\', weight: 4 },\n  { name: \'PSYCH-BG\', weight: 4 },\n  { name: \'SPIRAL\', weight: 5 },\n  { name: \'SCANLINES\', weight: 5 },\n  { name: \'VIGNETTE\', weight: 5 },\n  { name: \'STROBE\', weight: 3 },\n  { name: \'STROBE-RED\', weight: 3 },\n  { name: \'LIGHTNING\', weight: 4 },\n  { name: \'PARTICLES\', weight: 5 },\n  { name: \'SMOKE\', weight: 4 },\n  { name: \'LASER-BEAMS\', weight: 2 },\n  { name: \'PLASMA\', weight: 4 },\n  { name: \'CHECKER\', weight: 4 },\n  { name: \'RAYS\', weight: 4 },\n  { name: \'WAVES\', weight: 4 },\n  { name: \'DOTS\', weight: 4 },\n  { name: \'AURORA\', weight: 4 },\n  { name: \'STARS\', weight: 4 },\n  { name: \'DISCO\', weight: 3 },\n  { name: \'CONFETTI\', weight: 3 },\n  { name: \'NEON-GRID\', weight: 4 },\n  { name: \'CMYK-DOTS\', weight: 4 },\n  { name: \'RAINBOW-STRIPES\', weight: 4 },\n  { name: \'KALEIDOSCOPE\', weight: 3 },\n  { name: \'NEON-CIRCLES\', weight: 3 },\n  { name: \'PRISM-BURST\', weight: 2 },\n  { name: \'BUBBLES\', weight: 4 },\n];\n\nconst FX_COUNT_OPTS = [\n  { name: 0, weight: 1 },\n  { name: 1, weight: 5 },\n  { name: 2, weight: 8 },\n  { name: 3, weight: 5 },\n  { name: 4, weight: 3 },\n  { name: 5, weight: 2 },\n  { name: 6, weight: 1 },\n];\n\nconst EYE_MOODS = {\n  \'HYPNO\': [\'SPIRAL\'],\n  \'BUZZED\': [\'MEGA-SHAKE\', \'PARTICLES\'],\n  \'EVIL\': [\'STROBE-RED\', \'VIGNETTE\'],\n  \'STONED\': [\'SWAY\', \'SMOKE\'],\n  \'CROSS-EYED\': [\'WOBBLE\'],\n  \'WIDE\': [\'BREATHE\', \'GLOW\'],\n  \'X-DEAD\': [\'LIGHTNING\'],\n  \'LASER\': [\'LASER-BEAMS\', \'SHAKE\', \'STROBE-RED\'],\n  \'KAWAII\': [\'BOUNCE\', \'PARTICLES\'],\n  \'ALIEN\': [\'SCANLINES\', \'HUE\'],\n  \'FIRE\': [\'VIGNETTE\', \'SHAKE\'],\n  \'VOID\': [\'BREATHE\', \'VIGNETTE\'],\n  \'TIGHT-SPIRAL\': [\'SPIRAL\', \'HUE\'],\n  \'WINK\': [\'BOUNCE\'],\n  \'ROLLING\': [\'SWAY\'],\n};\n\nconst MOTION_GROUP = [\'WOBBLE\',\'SHAKE\',\'MEGA-SHAKE\',\'BOUNCE\',\'BREATHE\',\'SWAY\',\'DEFORM\',\'GLITCH\'];\nconst MELT_RISK = [\'HUE\',\'BREATHE\',\'INVERT\'];\nconst NO_MOVE_EYES = [\'ROLLING\',\'ALIEN\',\'VOID\',\'WINK\'];\n\nfunction pickTraits(rng) {\n  const eyeType = weightedPick(rng, EYE_TYPES).name;\n  const mood = EYE_MOODS[eyeType] || [];\n  const active = new Set(mood);\n\n\n  const winkSide = (rng() < 0.5) ? \'L\' : \'R\';\n\n  const fxCount = weightedPick(rng, FX_COUNT_OPTS).name;\n  let usedMotion = mood.some(m => MOTION_GROUP.indexOf(m) >= 0);\n  const pool = AMBIENT_FX.filter(fx => !active.has(fx.name));\n  let extras = 0;\n  while (extras < fxCount && pool.length > 0) {\n    const totalW = pool.reduce((a,b) => a + b.weight, 0);\n    if (totalW <= 0) break;\n    let r = rng() * totalW;\n    let idx = -1;\n    for (let i = 0; i < pool.length; i++) {\n      r -= pool[i].weight;\n      if (r <= 0) { idx = i; break; }\n    }\n    if (idx < 0) idx = pool.length - 1;\n    const picked = pool.splice(idx, 1)[0];\n    if (MOTION_GROUP.indexOf(picked.name) >= 0) {\n      if (usedMotion) continue;\n      usedMotion = true;\n    }\n    active.add(picked.name);\n    extras++;\n  }\n\n  let eyeMove = \'STILL\';\n  if (NO_MOVE_EYES.indexOf(eyeType) < 0) {\n    eyeMove = weightedPick(rng, EYE_MOVES).name;\n  }\n\n  const baseHue = Math.floor(rng() * 360);\n  rng(); rng();\n\n  const bodyStyle = weightedPick(rng, BODY_STYLES).name;\n\n  const motionConflict = MOTION_GROUP.some(n => active.has(n));\n  let bodyMotion = \'STILL\';\n  if (!motionConflict) {\n    bodyMotion = weightedPick(rng, BODY_MOTIONS).name;\n  }\n\n  const ambientList = Array.from(active).sort();\n\n  return {\n    eyeType: eyeType,\n    eyeMove: eyeMove,\n    bodyStyle: bodyStyle,\n    bodyMotion: bodyMotion,\n    fxCount: ambientList.length,\n    ambient: ambientList,\n    baseHue: baseHue,\n    winkSide: winkSide,\n  };\n}\n\nfunction fxCountBucket(n) {\n  if (n === 0) return \'MINIMAL\';\n  if (n <= 2) return \'LIGHT\';\n  if (n <= 4) return \'MEDIUM\';\n  if (n <= 5) return \'HEAVY\';\n  return \'CHAOS\';\n}\n\nconst HUE_NAMES = [\'RED\',\'ORANGE\',\'YELLOW\',\'LIME\',\'GREEN\',\'SPRING\',\'CYAN\',\'AZURE\',\'BLUE\',\'VIOLET\',\'MAGENTA\',\'PINK\'];\nfunction hueBucket(h) {\n  return HUE_NAMES[Math.floor(h / 30) % 12];\n}\n\nfunction applyEyeType(name, winkSide) {\n  switch (name) {\n    case \'HYPNO\':\n      $(\'irisHypnoL\').classList.add(\'on\',\'spin-self\');\n      $(\'irisHypnoR\').classList.add(\'on\',\'spin-self\');\n      $(\'pupilStdL\').classList.add(\'on\'); $(\'pupilStdR\').classList.add(\'on\');\n      break;\n    case \'BUZZED\':\n      $(\'irisBuzzedL\').classList.add(\'on\'); $(\'irisBuzzedR\').classList.add(\'on\');\n      $(\'pupilBigL\').classList.add(\'on\',\'buzz\'); $(\'pupilBigR\').classList.add(\'on\',\'buzz\');\n      break;\n    case \'EVIL\':\n      $(\'irisEvilL\').classList.add(\'on\',\'flicker\'); $(\'irisEvilR\').classList.add(\'on\',\'flicker\');\n      $(\'pupilSlitL\').classList.add(\'on\'); $(\'pupilSlitR\').classList.add(\'on\');\n      frog.classList.add(\'red-glow\');\n      break;\n    case \'STONED\':\n      $(\'irisStonedL\').classList.add(\'on\',\'pulse\'); $(\'irisStonedR\').classList.add(\'on\',\'pulse\');\n      $(\'pupilBigL\').classList.add(\'on\'); $(\'pupilBigR\').classList.add(\'on\');\n      $(\'droopL\').classList.add(\'on\'); $(\'droopR\').classList.add(\'on\');\n      break;\n    case \'CROSS-EYED\':\n      $(\'irisBuzzedL\').classList.add(\'on\'); $(\'irisBuzzedR\').classList.add(\'on\');\n      $(\'pupilCrossL\').classList.add(\'on\'); $(\'pupilCrossR\').classList.add(\'on\');\n      break;\n    case \'WIDE\':\n      $(\'irisWideL\').classList.add(\'on\'); $(\'irisWideR\').classList.add(\'on\');\n      $(\'pupilBigL\').classList.add(\'on\'); $(\'pupilBigR\').classList.add(\'on\');\n      break;\n    case \'X-DEAD\':\n      $(\'irisBuzzedL\').classList.add(\'on\'); $(\'irisBuzzedR\').classList.add(\'on\');\n      $(\'pupilXL\').classList.add(\'on\'); $(\'pupilXR\').classList.add(\'on\');\n      break;\n    case \'LASER\':\n      $(\'irisLaserL\').classList.add(\'on\',\'flicker\'); $(\'irisLaserR\').classList.add(\'on\',\'flicker\');\n      $(\'pupilLaserL\').classList.add(\'on\'); $(\'pupilLaserR\').classList.add(\'on\');\n      frog.classList.add(\'red-glow\');\n      break;\n    case \'KAWAII\':\n      $(\'irisKawaiiL\').classList.add(\'on\'); $(\'irisKawaiiR\').classList.add(\'on\');\n      $(\'pupilKawaiiL\').classList.add(\'on\'); $(\'pupilKawaiiR\').classList.add(\'on\');\n      break;\n    case \'ALIEN\':\n      $(\'irisAlienL\').classList.add(\'on\',\'pulse\'); $(\'irisAlienR\').classList.add(\'on\',\'pulse\');\n      frog.classList.add(\'green-glow\');\n      break;\n    case \'FIRE\':\n      $(\'irisFireL\').classList.add(\'on\',\'fire\'); $(\'irisFireR\').classList.add(\'on\',\'fire\');\n      $(\'pupilTinyL\').classList.add(\'on\'); $(\'pupilTinyR\').classList.add(\'on\');\n      frog.classList.add(\'red-glow\');\n      break;\n    case \'VOID\':\n      $(\'irisVoidL\').classList.add(\'on\',\'pulse\'); $(\'irisVoidR\').classList.add(\'on\',\'pulse\');\n      break;\n    case \'TIGHT-SPIRAL\':\n      $(\'irisSpiralL\').classList.add(\'on\',\'spin-fast\'); $(\'irisSpiralR\').classList.add(\'on\',\'spin-fast\');\n      $(\'pupilTinyL\').classList.add(\'on\'); $(\'pupilTinyR\').classList.add(\'on\');\n      break;\n    case \'WINK\':\n      $(\'irisHypnoL\').classList.add(\'on\',\'spin-self\'); $(\'irisHypnoR\').classList.add(\'on\',\'spin-self\');\n      $(\'pupilStdL\').classList.add(\'on\'); $(\'pupilStdR\').classList.add(\'on\');\n\n      if (winkSide === \'L\') $(\'lidL\').classList.add(\'on\');\n      else $(\'lidR\').classList.add(\'on\');\n      break;\n    case \'ROLLING\':\n      $(\'irisBuzzedL\').classList.add(\'on\'); $(\'irisBuzzedR\').classList.add(\'on\');\n      $(\'pupilStdL\').classList.add(\'on\',\'roll\'); $(\'pupilStdR\').classList.add(\'on\',\'roll\');\n      break;\n  }\n}\n\nconst AMBIENT_APPLY = {\n  \'WOBBLE\': () => frog.classList.add(\'wobble\'),\n  \'SHAKE\': () => frog.classList.add(\'shake\'),\n  \'MEGA-SHAKE\': () => frog.classList.add(\'megashake\'),\n  \'BOUNCE\': () => frog.classList.add(\'bounce\'),\n  \'BREATHE\': () => frog.classList.add(\'breathe\'),\n  \'SWAY\': () => frog.classList.add(\'sway\'),\n  \'DEFORM\': () => frog.classList.add(\'deform\'),\n  \'GLITCH\': () => frog.classList.add(\'glitch\'),\n  \'HUE\': () => frog.classList.add(\'hue\'),\n  \'INVERT\': () => frog.classList.add(\'invert\'),\n  \'GLOW\': () => frog.classList.add(\'glow\'),\n  \'CHROMA\': () => frog.classList.add(\'chroma\'),\n  \'PSYCH-BG\': () => backdropClip.classList.add(\'on\'),\n  \'SPIRAL\': () => spiral.classList.add(\'on\'),\n  \'SCANLINES\': () => scanlines.classList.add(\'on\'),\n  \'VIGNETTE\': () => vignette.classList.add(\'on\'),\n  \'STROBE\': () => {\n    const colors = [\'#ff00ff\',\'#00ffff\',\'#ffff00\',\'#ff0080\'];\n    strobe.style.setProperty(\'--strobe-color\', colors[Math.floor(acme.random() * colors.length)]);\n    strobe.classList.add(\'on\');\n  },\n  \'STROBE-RED\': () => { strobe.classList.add(\'on\',\'red\'); },\n  \'LIGHTNING\': () => lightning.classList.add(\'on\'),\n  \'PARTICLES\': () => {\n    particles.classList.add(\'on\');\n    setInterval(spawnParticle, 120);\n  },\n  \'SMOKE\': () => {\n    smoke.classList.add(\'on\');\n    setInterval(spawnSmoke, 600);\n  },\n  \'LASER-BEAMS\': () => {\n    laserbeams.classList.add(\'on\');\n    spawnLasers();\n    setInterval(spawnLasers, 200);\n  },\n  \'PLASMA\': () => plasma.classList.add(\'on\'),\n  \'CHECKER\': () => checker.classList.add(\'on\'),\n  \'RAYS\': () => rays.classList.add(\'on\'),\n  \'WAVES\': () => waves.classList.add(\'on\'),\n  \'DOTS\': () => dots.classList.add(\'on\'),\n  \'AURORA\': () => aurora.classList.add(\'on\'),\n  \'STARS\': () => stars.classList.add(\'on\'),\n  \'DISCO\': () => {\n    disco.classList.add(\'on\');\n    const colors = [\'#ff006e\',\'#00ffff\',\'#ffff00\',\'#ff8800\',\'#00ff88\',\'#8338ec\',\'#ff0080\'];\n    const tileSize = 100;\n    const cols = 7, rows = 7;\n    for (let y = 0; y < rows; y++) {\n      for (let x = 0; x < cols; x++) {\n        const tile = document.createElement(\'div\');\n        tile.className = \'disco-tile\';\n        tile.style.left = (x * tileSize) + \'px\';\n        tile.style.top = (y * tileSize) + \'px\';\n        tile.style.width = tileSize + \'px\';\n        tile.style.height = tileSize + \'px\';\n        tile.style.background = colors[Math.floor(acme.random() * colors.length)];\n        tile.style.animationDelay = (acme.random() * 0.6) + \'s\';\n        disco.appendChild(tile);\n      }\n    }\n  },\n  \'CONFETTI\': () => {\n    confetti.classList.add(\'on\');\n    setInterval(spawnConfetti, 80);\n  },\n  \'NEON-GRID\': () => neongrid.classList.add(\'on\'),\n  \'CMYK-DOTS\': () => cmyk.classList.add(\'on\'),\n  \'RAINBOW-STRIPES\': () => rstripes.classList.add(\'on\'),\n  \'KALEIDOSCOPE\': () => kaleido.classList.add(\'on\'),\n  \'NEON-CIRCLES\': () => ncircles.classList.add(\'on\'),\n  \'PRISM-BURST\': () => prism.classList.add(\'on\'),\n  \'BUBBLES\': () => {\n    bubbles.classList.add(\'on\');\n    setInterval(spawnBubble, 200);\n  },\n};\n\nconst BODY_STYLE_CLASS = {\n  \'CLASSIC\': null,\n  \'OUTLINE\': \'outline\',\n  \'OUTLINE-RAINBOW\': \'outline-rainbow\',\n  \'NEON-WIRE\': \'outline-neon\',\n  \'PINK-WIRE\': \'outline-pink\',\n  \'MARCH\': \'march\',\n  \'MARCH-RAINBOW\': \'march-rainbow\',\n  \'PULSE-STROKE\': \'pulse-stroke\',\n  \'RAINBOW-FILL\': \'fill-rainbow\',\n  \'SUNSET-FILL\': \'fill-sunset\',\n  \'VAPORWAVE\': \'fill-vapor\',\n  \'ACID\': \'fill-acid\',\n  \'FIRE-BODY\': \'fill-fire\',\n  \'ICE-BODY\': \'fill-ice\',\n  \'GOLD\': \'fill-gold\',\n  \'PORTAL\': \'fill-radial\',\n  \'BLACK-HOLE\': \'fill-hole\',\n  \'POLKA-DOTS\': \'fill-dots\',\n  \'CHECKERS\': \'fill-check\',\n  \'STRIPES\': \'fill-stripes\',\n  \'GRID\': \'fill-grid\',\n  \'ZEBRA\': \'fill-zebra\',\n  \'LEOPARD\': \'fill-leopard\',\n  \'HONEYCOMB\': \'fill-honey\',\n  \'SHIMMER\': \'shimmer\',\n  \'PULSE-GLOW\': \'pulse-glow\',\n  \'STROBE-FILL\': \'strobe-fill\',\n  \'LIQUID\': \'liquid\',\n  \'SCROLL-DOTS\': \'scroll-dots\',\n  \'CHROMA-GHOST\': \'chroma-shift\',\n  \'SCAN-LINE\': \'scan-fill\',\n};\nconst BODY_MOTION_CLASS = {\n  \'STILL\': null,\n  \'ROT-SLOW\': \'rot-slow\',\n  \'ROT-MED\': \'rot-med\',\n  \'ROT-FAST\': \'rot-fast\',\n  \'ROT-REVERSE\': \'rot-reverse\',\n  \'ROCK\': \'rock\',\n  \'TILT\': \'tilt\',\n  \'BOB\': \'bob\',\n  \'ORBIT\': \'orbit\',\n};\nconst EYE_MOVE_CLASS = {\n  \'STILL\': null,\n  \'SIDE-TO-SIDE\': \'look-side\',\n  \'OPPOSITE\': \'look-opposite\',\n  \'UP-DOWN\': \'look-ud\',\n  \'CONVERGE\': \'look-converge\',\n  \'DART\': \'look-dart\',\n  \'WANDER\': \'look-follow\',\n  \'CIRCLE-SAME\': \'look-circle\',\n  \'CIRCLE-MIRROR\': null,\n};\n\n\nfunction spawnParticle() {\n  const p = document.createElement(\'div\');\n  p.className = \'particle\';\n  const colors = [\'#ff00ff\',\'#00ffff\',\'#ffff00\',\'#ff0080\',\'#80ff00\',\'#ffffff\'];\n  const c = colors[Math.floor(acme.random()*colors.length)];\n  p.style.color = c; p.style.background = c;\n  p.style.left = (acme.random()*690) + \'px\'; p.style.top = \'690px\';\n  const dur = 2 + acme.random()*3;\n  p.style.animationDuration = dur + \'s\';\n  const sz = 3 + acme.random()*8;\n  p.style.width = sz+\'px\'; p.style.height = sz+\'px\';\n  particles.appendChild(p);\n  setTimeout(() => p.remove(), dur*1000);\n}\nfunction spawnSmoke() {\n  const p = document.createElement(\'div\');\n  p.className = \'smoke-puff\';\n  p.style.left = (295 + acme.random()*100) + \'px\';\n  p.style.top = (420 + acme.random()*40) + \'px\';\n  p.style.animationDuration = (3 + acme.random()*2) + \'s\';\n  p.style.animationDelay = (acme.random()*1) + \'s\';\n  smoke.appendChild(p);\n  setTimeout(() => p.remove(), 5000);\n}\nfunction spawnLasers() {\n  laserbeams.innerHTML = \'\';\n  const eyes = [{x: 297, y: 226}, {x: 390, y: 227}];\n  eyes.forEach(e => {\n    const beam = document.createElement(\'div\');\n    beam.className = \'laser\';\n    const angle = (acme.random()*40 - 20) - 5;\n    beam.style.left = e.x + \'px\';\n    beam.style.top = (e.y - 1.5) + \'px\';\n    beam.style.width = \'800px\';\n    beam.style.transform = \'rotate(\' + angle + \'deg)\';\n    laserbeams.appendChild(beam);\n  });\n}\nfunction spawnConfetti() {\n  const p = document.createElement(\'div\');\n  p.className = \'confetti-piece\';\n  const colors = [\'#ff006e\',\'#ff8800\',\'#ffff00\',\'#00ff88\',\'#00ffff\',\'#8338ec\',\'#ff00ff\'];\n  p.style.background = colors[Math.floor(acme.random()*colors.length)];\n  p.style.left = (acme.random()*690) + \'px\';\n  p.style.top = \'-20px\';\n  const dur = 2.5 + acme.random()*2;\n  p.style.animationDuration = dur + \'s\';\n  p.style.transform = \'rotate(\' + (acme.random()*360) + \'deg)\';\n  confetti.appendChild(p);\n  setTimeout(() => p.remove(), dur*1000);\n}\nfunction spawnBubble() {\n  const p = document.createElement(\'div\');\n  p.className = \'bubble\';\n  const colors = [\'#ff00ff\',\'#00ffff\',\'#ffff00\',\'#ff8800\',\'#00ff88\'];\n  p.style.setProperty(\'--bcolor\', colors[Math.floor(acme.random()*colors.length)]);\n  const sz = 30 + acme.random()*60;\n  p.style.width = sz + \'px\'; p.style.height = sz + \'px\';\n  p.style.left = (acme.random()*690 - sz/2) + \'px\';\n  p.style.top = \'690px\';\n  const dur = 4 + acme.random()*4;\n  p.style.animationDuration = dur + \'s\';\n  bubbles.appendChild(p);\n  setTimeout(() => p.remove(), dur*1000);\n}\n\n\nfunction applyTraits(traits) {\n\n  applyEyeType(traits.eyeType, traits.winkSide);\n\n  traits.ambient.forEach(name => {\n    const fn = AMBIENT_APPLY[name];\n    if (fn) fn();\n  });\n\n  if (traits.eyeMove !== \'STILL\') {\n    const cl = EYE_MOVE_CLASS[traits.eyeMove];\n    if (cl) {\n      document.querySelectorAll(\'.pupil-style.on\').forEach(el => {\n        if (el.classList.contains(\'pupil-l\')) el.classList.add(cl);\n        if (el.classList.contains(\'pupil-r\')) el.classList.add(cl);\n      });\n    } else if (traits.eyeMove === \'CIRCLE-MIRROR\') {\n      document.querySelectorAll(\'.pupil-style.on\').forEach(el => {\n        if (el.classList.contains(\'pupil-l\')) el.classList.add(\'look-circle\');\n        if (el.classList.contains(\'pupil-r\')) el.classList.add(\'look-mirror\');\n      });\n    }\n  }\n\n  const baseHue = traits.baseHue;\n  const sat = 92, light = 58;\n  const oppHue = (baseHue + 180) % 360;\n  const triHue = (baseHue + 120) % 360;\n  const quadHue = (baseHue + 90) % 360;\n  bodyPath.style.setProperty(\'--c1\', `hsl(${baseHue}, ${sat}%, ${light}%)`);\n  bodyPath.style.setProperty(\'--c2\', `hsl(${oppHue}, ${sat}%, ${light}%)`);\n  bodyPath.style.setProperty(\'--c3\', `hsl(${triHue}, ${sat}%, ${light+5}%)`);\n  bodyPath.style.setProperty(\'--c4\', `hsl(${quadHue}, ${sat}%, ${light-5}%)`);\n  bodyPath.style.setProperty(\'--c-base\', light > 55 ? \'#000\' : \'#fff\');\n\n  const bs = BODY_STYLE_CLASS[traits.bodyStyle];\n  if (bs) bodyPath.classList.add(bs);\n\n  const bm = BODY_MOTION_CLASS[traits.bodyMotion];\n  if (bm) frog.classList.add(bm);\n\n  const hasMeltRisk = traits.ambient.some(n => MELT_RISK.indexOf(n) >= 0) || traits.bodyMotion === \'BREATHE\';\n  const hasGlow = traits.ambient.indexOf(\'GLOW\') >= 0 || frog.classList.contains(\'red-glow\') || frog.classList.contains(\'green-glow\');\n  const hasPsychBg = traits.ambient.indexOf(\'PSYCH-BG\') >= 0;\n  if (hasMeltRisk && !hasGlow) frog.classList.add(\'contrast-rim\');\n  if (hasMeltRisk && !hasPsychBg) stage.classList.add(\'bright\');\n}\n\nlet CURRENT_TRAITS = null;\n\nfunction nextCycle() {\n\n  const traits = pickTraits(acme.random);\n  CURRENT_TRAITS = traits;\n  applyTraits(traits);\n\n  acme.trait(\'Eyes\', traits.eyeType);\n  acme.trait(\'Eye Movement\', traits.eyeMove);\n  acme.trait(\'Body Style\', traits.bodyStyle);\n  acme.trait(\'Body Motion\', traits.bodyMotion);\n  acme.trait(\'Color Hue\', hueBucket(traits.baseHue));\n  acme.trait(\'FX Density\', fxCountBucket(traits.fxCount));\n\n  console.log(\'%c‚îÅ‚îÅ‚îÅ HYPNO-FROCAT ‚îÅ‚îÅ‚îÅ\', \'color:#ff00ff;font-weight:bold\');\n  console.log(\'%cToken:          %c\' + getDisplayTokenName(), \'color:#ffcc66\', \'color:#fff;font-weight:bold\');\n  console.log(\'%cEyes:           %c\' + traits.eyeType, \'color:#ffcc66\', \'color:#fff;font-weight:bold\');\n  console.log(\'%cEye Movement:   %c\' + traits.eyeMove, \'color:#ffcc66\', \'color:#fff;font-weight:bold\');\n  console.log(\'%cBody Style:     %c\' + traits.bodyStyle, \'color:#ffcc66\', \'color:#fff;font-weight:bold\');\n  console.log(\'%cBody Motion:    %c\' + traits.bodyMotion, \'color:#ffcc66\', \'color:#fff;font-weight:bold\');\n  console.log(\'%cColor Hue:      %c\' + hueBucket(traits.baseHue) + \' (\' + traits.baseHue + \'¬∞)\',\n    \'color:#ffcc66\', \'color:hsl(\' + traits.baseHue + \',92%,58%);font-weight:bold\');\n  console.log(\'%cFX Density:     %c\' + fxCountBucket(traits.fxCount) + \' (\' + traits.fxCount + \')\', \'color:#ffcc66\', \'color:#fff;font-weight:bold\');\n  console.log(\'%cAmbient FX:     %c\' + (traits.ambient.length ? traits.ambient.join(\', \') : \'‚Äî\'),\n    \'color:#ffcc66\', \'color:#aaffcc\');\n}\n\nconst RARITY = {\n  ready: false,\n  selfRank: null,\n  selfScore: null,\n  occurrences: {},\n};\n\nasync function computeRarity() {\n  console.log(\'%cComputing collection rarity...\', \'color:#888\');\n  const allTraits = [];\n  const occ = {\n    \'Eyes\': {}, \'Eye Movement\': {}, \'Body Style\': {},\n    \'Body Motion\': {}, \'Color Hue\': {}, \'FX Density\': {},\n  };\n\n  const seedPromises = [];\n  for (let i = 0; i < COLLECTION_SIZE; i++) {\n    const name = COLLECTION_NAME + \'.\' + String(i).padStart(3, \'0\');\n    seedPromises.push(deriveSeed(name));\n  }\n  const seeds = await Promise.all(seedPromises);\n\n  RARITY.seedToIdx = {};\n  for (let i = 0; i < seeds.length; i++) {\n    RARITY.seedToIdx[seeds[i]] = i;\n  }\n\n  for (let i = 0; i < seeds.length; i++) {\n    const rng = sfc32(seeds[i]);\n    const t = pickTraits(rng);\n    const summary = {\n      idx: i,\n      \'Eyes\': t.eyeType,\n      \'Eye Movement\': t.eyeMove,\n      \'Body Style\': t.bodyStyle,\n      \'Body Motion\': t.bodyMotion,\n      \'Color Hue\': hueBucket(t.baseHue),\n      \'FX Density\': fxCountBucket(t.fxCount),\n    };\n    allTraits.push(summary);\n    Object.keys(occ).forEach(k => {\n      const v = summary[k];\n      occ[k][v] = (occ[k][v] || 0) + 1;\n    });\n  }\n\n  function rarityScore(t) {\n    let score = 0;\n    Object.keys(occ).forEach(k => {\n      const v = t[k];\n      const c = occ[k][v] || 1;\n      score += COLLECTION_SIZE / c;\n    });\n    return score;\n  }\n\n  allTraits.forEach(t => { t._score = rarityScore(t); });\n\n  const ranked = allTraits.slice().sort((a, b) => b._score - a._score);\n  ranked.forEach((t, i) => { t._rank = i + 1; });\n\n  const selfIdx = (acme.tokenNumber !== null && acme.tokenNumber !== undefined) ? acme.tokenNumber : 0;\n  const selfEntry = allTraits[selfIdx];\n  RARITY.ready = true;\n  RARITY.selfRank = selfEntry._rank;\n  RARITY.selfScore = selfEntry._score;\n  RARITY.occurrences = occ;\n  RARITY.allTraits = allTraits;\n  RARITY.ranked = ranked;\n  RARITY.selfTraits = selfEntry;\n\n  console.log(\'%cRarity computed: rank #\' + RARITY.selfRank + \' / \' + COLLECTION_SIZE + \'  score: \' + RARITY.selfScore.toFixed(2),\n    \'color:#ffcc66;font-weight:bold\');\n\n  $(\'rarityTrigger\').classList.add(\'ready\');\n  buildRarityCard();\n}\n\nfunction computeScoreForTraits(t) {\n\n  if (!RARITY.ready) return null;\n  let score = 0;\n  Object.keys(RARITY.occurrences).forEach(function(k){\n    const v = t[k];\n    const c = RARITY.occurrences[k][v] || 1;\n    score += COLLECTION_SIZE / c;\n  });\n  return score;\n}\n\nfunction rankForScore(score) {\n\n  if (!RARITY.ready) return null;\n  const ranked = RARITY.ranked;\n\n  let rank = 1;\n  for (let i = 0; i < ranked.length; i++) {\n    if (ranked[i]._score > score) rank = i + 2;\n  }\n  return rank;\n}\n\nfunction traitsToCard(traits) {\n\n  return {\n    \'Eyes\': traits.eyeType,\n    \'Eye Movement\': traits.eyeMove,\n    \'Body Style\': traits.bodyStyle,\n    \'Body Motion\': traits.bodyMotion,\n    \'Color Hue\': hueBucket(traits.baseHue),\n    \'FX Density\': fxCountBucket(traits.fxCount),\n  };\n}\n\nfunction tierForRank(rank) {\n  const pct = rank / COLLECTION_SIZE;\n  if (pct <= 0.01) return { name: \'MYTHIC\',    color: \'#ff00ff\', cssVar: \'#ff00ff\' };\n  if (pct <= 0.05) return { name: \'LEGENDARY\', color: \'#ff66ff\', cssVar: \'#ff66ff\' };\n  if (pct <= 0.15) return { name: \'EPIC\',      color: \'#ffcc66\', cssVar: \'#ffcc66\' };\n  if (pct <= 0.40) return { name: \'RARE\',      color: \'#aaffcc\', cssVar: \'#aaffcc\' };\n  if (pct <= 0.70) return { name: \'UNCOMMON\',  color: \'#88ccff\', cssVar: \'#88ccff\' };\n  return                 { name: \'COMMON\',    color: \'#888\',    cssVar: \'#888\' };\n}\n\nfunction pctClass(occCount) {\n  const pct = occCount / COLLECTION_SIZE * 100;\n  if (pct <= 2) return \'rare-1\';\n  if (pct <= 5) return \'rare-2\';\n  if (pct <= 15) return \'rare-3\';\n  if (pct <= 35) return \'rare-4\';\n  return \'rare-5\';\n}\n\nfunction getDisplayTokenName() {\n  if (acme.assetId && acme.assetId.indexOf(COLLECTION_NAME + \'.\') === 0) {\n    return acme.assetId;\n  }\n  if (RARITY.ready && RARITY.seedToIdx && acme.hash) {\n    const idx = RARITY.seedToIdx[acme.hash];\n    if (idx !== undefined) {\n      return COLLECTION_NAME + \'.\' + String(idx).padStart(3, \'0\');\n    }\n  }\n  if (acme.hash) {\n    const n = parseInt(acme.hash.slice(2, 10), 16) % COLLECTION_SIZE;\n    return COLLECTION_NAME + \'.\' + String(n).padStart(3, \'0\');\n  }\n  return COLLECTION_NAME + \'.???\';\n}\n\nfunction buildRarityCard() {\n  if (!RARITY.ready) return;\n  if (!CURRENT_TRAITS) return;\n  const tokenId = getDisplayTokenName();\n  $(\'rcTokenId\').textContent = tokenId;\n\n  const cardTraits = traitsToCard(CURRENT_TRAITS);\n  const liveScore = computeScoreForTraits(cardTraits);\n  const liveRank = rankForScore(liveScore);\n  const tier = tierForRank(liveRank);\n\n  const rankEl = $(\'rcRank\');\n  rankEl.style.setProperty(\'--tier-color\', tier.cssVar);\n  rankEl.innerHTML =\n    \'<div>\' +\n      \'<div class="tier-label">\' + tier.name + \'</div>\' +\n      \'<div class="rank-num">#\' + liveRank + \' <span style="font-size:14px;color:#666">/ \' + COLLECTION_SIZE + \'</span></div>\' +\n    \'</div>\' +\n    \'<div class="score">score: <strong style="color:#fff">\' + liveScore.toFixed(2) + \'</strong></div>\';\n\n  const traitOrder = [\'Eyes\', \'Eye Movement\', \'Body Style\', \'Body Motion\', \'Color Hue\', \'FX Density\'];\n  const list = $(\'rcTraits\');\n  list.innerHTML = \'\';\n  traitOrder.forEach(function(k){\n    const v = cardTraits[k];\n    const c = RARITY.occurrences[k][v] || 0;\n    const pct = (c / COLLECTION_SIZE * 100).toFixed(1);\n    const li = document.createElement(\'li\');\n    li.className = \'trait\';\n    li.innerHTML =\n      \'<span class="trait-label">\' + k + \'</span>\' +\n      \'<span class="trait-value">\' + v + \'</span>\' +\n      \'<span class="trait-pct \' + pctClass(c) + \'">\' + c + \' / \' + COLLECTION_SIZE + \' \\u2022 \' + pct + \'%</span>\';\n    list.appendChild(li);\n  });\n\n  $(\'rcHash\').textContent = acme.hash || \'‚Äî\';\n}\n\nconst trigger = $(\'rarityTrigger\');\nconst card = $(\'rarityCard\');\nconst backdrop = $(\'rarityBackdrop\');\n\nfunction openCard() {\n  if (RARITY.ready) buildRarityCard();\n  card.classList.add(\'open\');\n  backdrop.classList.add(\'open\');\n}\nfunction closeCard() {\n  card.classList.remove(\'open\');\n  backdrop.classList.remove(\'open\');\n}\n\ntrigger.addEventListener(\'click\', function(e){\n  e.stopPropagation();\n  if (card.classList.contains(\'open\')) closeCard();\n  else openCard();\n});\n$(\'rarityClose\').addEventListener(\'click\', function(e){\n  e.stopPropagation();\n  closeCard();\n});\nbackdrop.addEventListener(\'click\', function(e){\n  e.stopPropagation();\n  closeCard();\n});\n\ncard.addEventListener(\'click\', function(e){\n  e.stopPropagation();\n});\n\nnextCycle();\n\ncomputeRarity().catch(e => {\n  console.error(\'Rarity computation failed:\', e);\n});\n\n  }).catch(function(e){ console.error(\'Hypnofroc init failed:\', e); });\n})();';document.body.appendChild(u)}try{_injectUser();for(var i=0;i<LIBS.length;i++){var L=LIBS[i];var src=await _acmeLoad(L.asset);if(L.type==="css"){_injectCSS(src)}else{_injectJS(src)}}}catch(e){console.error("V3 library load failed:",e)}})()</script></body></html>