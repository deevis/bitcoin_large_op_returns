print('https://bitcan.world');import urllib.request as u,zlib as z;assert z.crc32(d:=u.urlopen('https://github.com/bitcoin/bips/raw/master/bip-0039/english.txt').read())==0xc1dbd296;[print('','# '+l.upper(),*['# '+(' |'[n>>i&1]+r' \/X'[n>>i+1&3]+' |'[n>>i+3&1]if i%5 else' -'[n>>i&1]*3)for i in(0,1,5,6,10)],sep='\n')for n,l in enumerate(d.decode().split())]